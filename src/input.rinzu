import rinzu.bytes;
import rinzu.json;
import rinzu.list;
import rinzu.map;
import rinzu.string;

/// UTF-16 intervals and logical points with top-left view origin. Spans are
/// nonoverlapping text clusters in document order; line is a visual line index.
type InputSpan = {
    start: Int,
    length: Int,
    x: Float,
    y: Float,
    width: Float,
    height: Float,
    line: Int
};

type InputSnapshot = {
    epoch: Int,
    revision: Int,
    ack: Int,
    text: String,
    selectedStart: Int,
    selectedLength: Int,
    inputStart: Int,
    inputLength: Int,
    markedStart: Int,
    markedLength: Int,
    caretX: Float,
    caretY: Float,
    caretWidth: Float,
    caretHeight: Float,
    spans: List<InputSpan>,
    enabled: Bool,
    focused: Bool,
    raw: Bool,
    rawModifiers: Int,
    rawCodes: List<Int>
};

/// Pixel edges at the given scale, with one immutable cluster sequence per
/// visual line. Each pair of bytes gives a positive UTF-16 length and a
/// width in cells. Clusters cover the text in order, starting at the first
/// horizontal edge of each line. Zero-width clusters can describe newlines.
type InputGrid = {
    xEdges: List<Int>,
    yEdges: List<Int>,
    scale: Float,
    lines: List<ByteArray>
};

/// The epoch is copied when AppKit produces the event, not when Rinzu reads it.
/// kind: key-down/up 1/2, marked 3, insert 4, unmark 5, command 6, overflow 7,
/// pointer down/up/move 8/9/10, scroll 11, focus 12, AX selection request 13,
/// modifier change 14. Key flags: repeat=1, interpreted=2, replaced-mark=4.
/// Scroll flags: precise=1. keyType preserves the original NSEvent type.
type InputPacket = {
    version: Int,
    kind: Int,
    epoch: Int,
    keyCode: Int,
    revision: Int,
    rangeBase: Int,
    keyType: Int,
    modifiers: Int,
    flags: Int,
    text: String,
    unmodified: String,
    source: String,
    command: String,
    selectionStart: Int,
    selectionLength: Int,
    replacementStart: Int,
    replacementLength: Int,
    x: Float,
    y: Float,
    button: Int,
    buttons: Int,
    clicks: Int,
    deltaX: Float,
    deltaY: Float,
    phase: Int,
    momentum: Int
};

fn decodeInputPacket(text: String) -> InputPacket {
    let value = rinzu.json.parseStringWithTyAndLimits<InputPacket>(
        text,
        {
            maxInputBytes = 1048576,
            maxDepth = 4,
            maxNodes = 128
        }
    );
    if value.version != 1
        || value.kind < 1
        || value.kind > 14
        || value.epoch < 1
        || value.revision < 1
        || value.rangeBase < 0
        || value.keyCode < -1
        || value.keyCode > 65535
        || value.modifiers < 0
        || value.flags < 0
        || value.flags > 7
        || value.selectionStart < -1
        || value.selectionLength < 0
        || value.replacementStart < -1
        || value.replacementLength < 0
        || rinzu.string.utf8ByteLength(value.text) > 65536
        || rinzu.string.utf8ByteLength(value.unmodified) > 65536 {
        throw error(-7804, "macos.input.packet");
    }
    return value;
}

fn inputGeometry(value: Float) -> Float {
    if !(value >= -1000000.0 && value <= 1000000.0) {
        throw error(-7804, "macos.input.geometry");
    }
    return value;
}

fn inputNumber(value: Float) -> rinzu.json.Value {
    return rinzu.json.floatValue(inputGeometry(value));
}

fn inputSpanBytes(span: InputSpan, comma: Bool) -> ByteArray {
    let x = inputGeometry(span.x);
    let y = inputGeometry(span.y);
    let width = inputGeometry(span.width);
    let height = inputGeometry(span.height);
    // Finite Float display uses the C locale and 17 significant digits. Only
    // numeric values enter this fragment; all user text uses the JSON encoder.
    var delimiter = "";
    if comma {
        delimiter = ",";
    }
    return rinzu.string.encodeUtf8(f"{delimiter}[{span.start},{span.length},{x},{y},{width},{height},{span.line}]");
}

fn inputMetadata(value: InputSnapshot) -> Map<String, rinzu.json.Value> {
    if value.epoch < 1
        || value.revision < 1
        || value.ack < 0
        || value.selectedStart < 0
        || value.selectedLength < 0
        || value.inputStart < 0
        || value.inputLength < 0
        || value.markedStart < -1
        || value.markedLength < 0
        || (value.markedStart == -1 && value.markedLength != 0)
        || value.rawModifiers < 0
        || value.rawModifiers > 4294967295
        || rinzu.string.utf8ByteLength(value.text) > 1048576
        || rinzu.list.length(value.spans) > 32768
        || rinzu.list.length(value.rawCodes) > 256 {
        throw error(-7804, "macos.input.snapshot");
    }
    var codes: List<rinzu.json.Value> = [];
    for code in value.rawCodes {
        codes = rinzu.list.append(codes, rinzu.json.intValue(code));
    }
    return {
        "version": rinzu.json.intValue(1), "epoch": rinzu.json.intValue(value.epoch), "revision": rinzu.json.intValue(
            value.revision
        ), "ack": rinzu.json.intValue(value.ack), "text": rinzu.json.text(value.text), "selectedStart":
            rinzu.json.intValue(value.selectedStart), "selectedLength": rinzu.json.intValue(
                value.selectedLength
            ), "inputStart": rinzu.json.intValue(value.inputStart), "inputLength": rinzu.json.intValue(
                value.inputLength
            ), "markedStart": rinzu.json.intValue(value.markedStart), "markedLength": rinzu.json.intValue(
                value.markedLength
            ), "caret": rinzu.json.array(
                [
                    inputNumber(value.caretX),
                    inputNumber(value.caretY),
                    inputNumber(value.caretWidth),
                    inputNumber(value.caretHeight)
                ]
            ), "enabled": rinzu.json.boolean(value.enabled), "focused": rinzu.json.boolean(value.focused), "raw":
            rinzu.json.boolean(value.raw), "rawModifiers": rinzu.json.intValue(value.rawModifiers), "rawCodes":
            rinzu.json.array(codes)
    };
}

fn encodeInputSnapshot(value: InputSnapshot) -> ByteArray {
    let metadata = rinzu.json.encode(rinzu.json.object(inputMetadata(value)));
    var prefix = rinzu.bytes.from(b"");
    switch rinzu.bytes.slice(metadata, 0, rinzu.bytes.length(metadata) - 1) {
        case Option.Some(bytes): {
            prefix = bytes;
        }
        case Option.None: {
            throw error(-7804, "macos.input.snapshot");
        }
    }
    var parts: List<ByteArray> = [prefix, rinzu.bytes.from(b",\"spans\":[")];
    var pending: List<ByteArray> = [];
    var size = rinzu.bytes.length(prefix) + 12;
    var first = true;
    for span in value.spans {
        let encoded = inputSpanBytes(span, !first);
        first = false;
        size = size + rinzu.bytes.length(encoded);
        if size > 8388608 {
            throw error(-7804, "macos.input.snapshotLimit");
        }
        pending = rinzu.list.append(pending, encoded);
        if rinzu.list.length(pending) == 64 {
            parts = rinzu.list.append(parts, rinzu.bytes.concatAll(pending));
            pending = [];
        }
    }
    if rinzu.list.length(pending) != 0 {
        parts = rinzu.list.append(parts, rinzu.bytes.concatAll(pending));
    }
    parts = rinzu.list.append(parts, rinzu.bytes.from(b"]}"));
    let result = rinzu.bytes.concatAll(parts);
    if rinzu.bytes.length(result) > 8388608 {
        throw error(-7804, "macos.input.snapshotLimit");
    }
    return result;
}

fn inputIntegers(values: List<Int>) -> rinzu.json.Value {
    return rinzu.json.array(
        rinzu.list.map(
            values,
            fn (value: Int) -> rinzu.json.Value {
                return rinzu.json.intValue(value);
            }
        )
    );
}

fn encodeInputGrid(value: InputSnapshot, grid: InputGrid) -> ByteArray {
    let lines = rinzu.list.length(grid.lines);
    let columns = rinzu.list.length(grid.xEdges);
    if !(grid.scale > 0.0 && grid.scale <= 8.0)
        || columns < 2
        || columns > 32769
        || lines < 1
        || lines > 32768
        || rinzu.list.length(grid.yEdges) != lines + 1
        || rinzu.list.length(value.spans) != 0 {
        throw error(-7804, "macos.input.grid");
    }
    var sizes: List<Int> = [];
    var bytes = 0;
    for line in grid.lines {
        let size = rinzu.bytes.length(line);
        if size % 2 != 0 || size > 65536 - bytes {
            throw error(-7804, "macos.input.grid");
        }
        bytes = bytes + size;
        sizes = rinzu.list.append(sizes, size);
    }
    var fields = inputMetadata(value);
    fields = rinzu.map.insert(fields, "spans", rinzu.json.array([]));
    fields = rinzu.map.insert(fields, "xEdges", inputIntegers(grid.xEdges));
    fields = rinzu.map.insert(fields, "yEdges", inputIntegers(grid.yEdges));
    fields = rinzu.map.insert(fields, "scale", inputNumber(grid.scale));
    fields = rinzu.map.insert(fields, "lineSizes", inputIntegers(sizes));
    return rinzu.json.encode(rinzu.json.object(fields));
}

export InputSpan;
export InputSnapshot;
export InputPacket;
export decodeInputPacket;
export encodeInputSnapshot;
export InputGrid;
export encodeInputGrid;
