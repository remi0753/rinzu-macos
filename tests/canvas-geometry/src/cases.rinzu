import rinzu.io;
import rinzu.macos as macos;
import rinzu.stdio;
import rinzu.testing;
import rinzu.timer;

class Probe {
    canvas: Option<macos.Canvas2D>,
    draws: Int,
    recovered: Bool
}

fn canvas(probe: Probe) -> macos.Canvas2D {
    switch probe.canvas {
        case Option.Some(value): {
            return value;
        }
        case Option.None: {
            throw error(1, "canvas is not ready");
        }
    }
}

async fn application(app: macos.UiApplication, probe: Probe) {
    let scope = app.primary;
    let device = app.session.device();
    let baseline = macos.statistics();
    let options = macos.CanvasOptions.create(32, 60, macos.Color(red: 0.0, green: 0.0, blue: 0.0, alpha: 1.0));
    options.displayPaced = true;
    options.pixelFormat = macos.pixelBGRA8Srgb;
    let output = scope.canvas2DWithOptions(
        device,
        macos.Rect(x: 10.0, y: 10.0, width: 240.0, height: 120.0),
        options,
        async fn (frame: macos.Frame2D) {
            probe.draws = probe.draws + 1;
            if probe.draws == 1 {
                let target = canvas(probe);
                let resized = target.view.setFrame(macos.Rect(x: 10.0, y: 10.0, width: 239.0, height: 119.0));
                // Deterministically model a queued frame whose extent became stale.
                // Neither the old nor the resized drawable can match this extent.
                frame.batch.reset(frame.info.width + 2, frame.info.height + 2);
            }
            frame.usePixels();
            frame.batch.fillRect(
                macos.Rect(x: 0.0, y: 0.0, width: 40.0, height: 40.0),
                macos.Color(red: 0.0, green: 1.0, blue: 0.0, alpha: 1.0)
            );
        }
    );
    probe.canvas = Option<macos.Canvas2D>.Some(value: output);
    let observing = scope.start(
        async fn (job: macos.UiJob) {
            let deadline = rinzu.io.monotonicMillis() + 10000;
            // Display refresh and Metal completion determine how many waits are needed.
            while output.frames < 1 && !job.isStopping() {
                rinzu.testing.assertTrue(rinzu.io.monotonicMillis() < deadline, "stale canvas frame did not recover");
                await rinzu.timer.sleep(5);
            }
            if !job.isStopping() {
                let clockStats = output.clock.statistics();
                rinzu.testing.assertTrue(
                    probe.draws >= 2 && clockStats.retries >= 1,
                    "canvas did not retry stale geometry"
                );
                rinzu.testing.assertEqual<Int>(
                    output.view.pixelFormat(),
                    macos.pixelBGRA8Srgb,
                    "configured canvas format"
                );
                let closed = await scope.closeCanvas(output);
                let repeated = await scope.closeCanvas(output);
                let live = macos.statistics();
                rinzu.testing.assertTrue(
                    output.disposed
                        && live.windows == baseline.windows
                        && live.views == baseline.views
                        && live.frameClocks == baseline.frameClocks
                        && live.commands == baseline.commands
                        && live.textures == baseline.textures
                        && live.bufferBytes == baseline.bufferBytes,
                    "canvas can be released before its window"
                );
                probe.recovered = true;
                scope.requestStop();
            }
        }
    );
    await scope.dispatch(
        async fn (owner: macos.UiScope, event: macos.UiEvent) {
            if event.kind == macos.eventCloseRequested || event.kind == macos.eventQuitRequested {
                owner.requestStop();
            }
        }
    );
}

async fn run() {
    let probe = Probe(canvas: Option<macos.Canvas2D>.None(), draws: 0, recovered: false);
    let ran = await macos.application(
        "Canvas geometry retry",
        320.0,
        180.0,
        async fn (app: macos.UiApplication) {
            await application(app, probe);
        }
    );
    rinzu.testing.assertTrue(probe.recovered, "canvas scenario did not finish");
    let resources = macos.statistics();
    rinzu.testing.assertTrue(
        resources.sessions == 0
            && resources.windows == 0
            && resources.views == 0
            && resources.devices == 0
            && resources.commands == 0
            && resources.bufferBytes == 0
            && resources.textures == 0
            && resources.frameClocks == 0
            && resources.frameTimers == 0
            && resources.frameWaiters == 0,
        "canvas resources remained live"
    );
    rinzu.stdio.writeLine("CANVAS:geometry-retry:closed");
}

export run;
