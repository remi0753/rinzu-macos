import rinzu.macos as macos;
import rinzu.stdio;
import rinzu.testing;
import rinzu.timer;

async fn body(app: macos.UiApplication) throws(Error) {
    let scope = app.primary;
    let device = scope.session.device();
    let view = scope.surface(device, macos.Rect(x: 0.0, y: 0.0, width: 320.0, height: 180.0));
    try {
        let format = view.setPixelFormat(macos.pixelBGRA8Srgb);
        let root = scope.window.contentView();
        let attached = root.addSubview(view);
        let clock = view.displayClock(240);
        try {
            let command = device.command();
            try {
                let registered = scope.start(
                    async fn (job: macos.UiJob) {
                        let animating = clock.setAnimating(true);
                        var count = 0;
                        while count < 120 && !job.isStopping() {
                            switch await clock.next() {
                                case Option.Some(info): {
                                    let begun = command.beginRenderMatching(
                                        view,
                                        macos.Color(red: 0.125, green: 0.25, blue: 0.5, alpha: 1.0),
                                        info.width,
                                        info.height
                                    );
                                    let submitted = command.commit();
                                    let finished = await command.wait();
                                    let presented = clock.presented();
                                    let timing = clock.timing();
                                    rinzu.stdio.writeLine(
                                        f"DISPLAY:{count}:{timing.source}:{timing.maximumFPS}:{info.time}:{info.delta}:{timing.period}"
                                    );
                                    count = count + 1;
                                }
                                case Option.None: {
                                    throw error(1, "display clock stopped early");
                                }
                            }
                        }
                        rinzu.testing.assertEqual<Int>(count, 120, "120 display-paced presentations");
                        let steady = clock.setAnimating(false);
                        let before = clock.statistics();
                        await rinzu.timer.sleep(250);
                        let idle = clock.statistics();
                        let idleResources = macos.statistics();
                        rinzu.testing.assertTrue(
                            before.ticks == idle.ticks && idleResources.frameTimers == 0,
                            "idle owns no display callback"
                        );
                        let hidden = view.setHidden(true);
                        let dirty = clock.invalidate();
                        await rinzu.timer.sleep(250);
                        let hiddenStats = clock.statistics();
                        let hiddenResources = macos.statistics();
                        rinzu.testing.assertTrue(
                            hiddenStats.ticks == idle.ticks && hiddenResources.frameTimers == 0,
                            "hidden owns no display callback"
                        );
                        let visible = view.setHidden(false);
                        switch await clock.next() {
                            case Option.Some(resumed): {
                                rinzu.testing.assertTrue(resumed.sequence > count, "resumed display frame");
                            }
                            case Option.None: {
                                throw error(1, "display clock did not resume");
                            }
                        }
                        let stopped = clock.stop();
                        scope.requestStop();
                    }
                );
                try {
                    await scope.dispatch(async fn (owner: macos.UiScope, event: macos.UiEvent) {});
                }
                finally {
                    scope.requestStop();
                    let joined = await scope.join();
                }
            }
            finally {
                let commandRetired = command.destroy();
            }
        }
        finally {
            let clockRetired = clock.destroy();
        }
    }
    finally {
        let viewRetired = view.destroy();
    }
}

async fn main() {
    try {
        let ran = await macos.application("Display timing", 320.0, 180.0, body);
        let remaining = macos.statistics();
        rinzu.testing.assertTrue(
            remaining.sessions == 0
                && remaining.frameClocks == 0
                && remaining.frameTimers == 0
                && remaining.frameWaiters == 0
                && remaining.commands == 0,
            "display resources retire"
        );
        rinzu.stdio.writeLine("DISPLAY:idle:hidden:resume:resources=0");
    }
    catch [problem: Error, ...rest] {
        panic(f"Display timing: {problem.message}");
    }
}
