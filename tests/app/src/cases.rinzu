import rinzu.macos;
import "shaping.rinzu" as shaped;
import "input.rinzu" as inputChecked;
import rinzu.stdio;
import rinzu.testing;
import rinzu.bytes as bytesApi;
import rinzu.core;
import rinzu.error as err;
import rinzu.future as future;

class RunProbe {
    const view: rinzu.macos.View,
    const retained: rinzu.macos.Rect,
    calls: Int
}

async fn capturedRun() {
    var iteration = 0;
    while iteration < 2 {
        let session = rinzu.macos.open();
        let window = session.window("Rinzu captured RunContext", 240.0, 160.0);
        let shown = window.show();
        let probe = RunProbe(
            view: window.contentView(),
            retained: rinzu.macos.Rect(x: 19.0, y: 23.0, width: 240.0, height: 160.0),
            calls: 41
        );
        let result = await session.run(
            fn (context: rinzu.macos.RunContext, event: rinzu.macos.Event) -> Unit fallback () {
                if event.kind == rinzu.macos.eventStarted {
                    try {
                        rinzu.testing.assertTrue(context.session.isRunning(), "restored RunContext");
                        var index = 0;
                        while index < 32 {
                            let transient = f"callback collection {index}";
                            rinzu.testing.assertTrue(transient != "", "temporary callback data");
                            index = index + 1;
                        }
                        let frame = probe.view.frame();
                        rinzu.testing.assertTrue(frame.width > 0.0, "captured class handle");
                        rinzu.testing.assertTrue(
                            probe.retained.x == 19.0 && event.kind == rinzu.macos.eventStarted,
                            "captured native reference and callback record"
                        );
                        probe.calls = probe.calls + 1;
                    }
                    finally {
                        let stopped = context.session.stop();
                    }
                }
            }
        );
        rinzu.testing.assertEqual<Int>(result, 0, "native run returned");
        rinzu.testing.assertEqual<Int>(probe.calls, 42, "private captured class survived callback");
        rinzu.testing.assertTrue(!session.isRunning(), "stopped through restored context");
        let closed = await session.close();
        iteration = iteration + 1;
    }
    rinzu.stdio.writeLine("SOURCE:callback-ok:2:42");
}

async fn rejectSecondApplication(session: rinzu.macos.Session, view: rinzu.macos.View) {
    let identity = view.identity();
    var rejected = false;
    try {
        let status = await rinzu.macos.application(
            "Second application",
            240.0,
            160.0,
            async fn (app: rinzu.macos.UiApplication) {
                rinzu.core.panic("an already open session admitted another application");
            }
        );
    }
    catch [problem: Error, ...rest] {
        rinzu.testing.assertEqual<Option<Int>>(err.nativeStatus(problem), Option<Int>.Some(value: -7803), "open busy");
        rejected = true;
    }
    rinzu.testing.assertTrue(rejected, "second application rejected");
    let stats = rinzu.macos.statistics();
    rinzu.testing.assertEqual<Int>(stats.sessions, 1, "original session remains open");
    rinzu.testing.assertEqual<Int>(view.identity(), identity, "original view remains live");
    let sequence = session.eventSequence();
}

async fn core() {
    inputChecked.run();
    let session = rinzu.macos.open();
    let view = session.view(rinzu.macos.Rect(x: 2.0, y: 3.0, width: 20.0, height: 30.0));
    await rejectSecondApplication(session, view);
    let frame = view.frame();
    rinzu.testing.assertTrue(
        frame.x == 2.0 && frame.y == 3.0 && frame.width == 20.0 && frame.height == 30.0,
        "native geometry"
    );
    let snapshot: rinzu.macos.InputSnapshot = {
        epoch = 1,
        revision = 1,
        ack = 0,
        text = "A日😀",
        selectedStart = 2,
        selectedLength = 2,
        inputStart = 2,
        inputLength = 2,
        markedStart = -1,
        markedLength = 0,
        caretX = 10.0,
        caretY = 20.0,
        caretWidth = 1.0,
        caretHeight = 18.0,
        spans = [
            {
                start = 0,
                length = 1,
                x = 0.0,
                y = 0.0,
                width = 10.0,
                height = 18.0,
                line = 0
            },
            {
                start = 1,
                length = 1,
                x = 10.0,
                y = 0.0,
                width = 20.0,
                height = 18.0,
                line = 0
            },
            {
                start = 2,
                length = 2,
                x = 30.0,
                y = 0.0,
                width = 20.0,
                height = 18.0,
                line = 0
            }
        ],
        enabled = true,
        focused = false,
        raw = false,
        rawModifiers = 0,
        rawCodes = []
    };
    let input = view.publishInput(snapshot);
    let grid: rinzu.macos.InputGrid = {
        xEdges = [0, 15, 31, 46, 62, 77],
        yEdges = [0, 27],
        scale = 1.5,
        lines = [bytesApi.from(b"\x01\x01\x01\x02\x02\x02")]
    };
    let compact: rinzu.macos.InputSnapshot = {
        ...snapshot,
        revision = 2,
        spans = []
    };
    let published = view.publishGridInput(compact, grid);
    let again = view.publishGridInput(compact, grid);
    var rejected = false;
    try {
        let changed = view.publishGridInput(
            { ...compact, revision = 3 },
            {
                ...grid,
                lines = [bytesApi.from(b"\x01\x01\x01\x02\x01\x01\x01\x01")]
            }
        );
    }
    catch [problem: Error, ...rest] {
        rejected = err.nativeStatus(problem) == Option<Int>.Some(value: -7804);
    }
    rinzu.testing.assertTrue(rejected, "grid clusters cannot split a UTF-16 surrogate pair");
    let inputState = view.inputState();
    rinzu.testing.assertTrue(
        inputState.epoch == 1 && inputState.selectedStart == 2 && inputState.selectedLength == 2,
        "owned UTF-16 input projection"
    );
    let backing = view.convertRect(rinzu.macos.Rect(x: 0.0, y: 0.0, width: 1.0, height: 1.0), 0);
    let logical = view.convertRect(backing, 1);
    rinzu.testing.assertTrue(logical.width == 1.0 && logical.height == 1.0, "backing coordinate round trip");
    let discarded = view.discardMarkedText();
    let detached = view.detachInput();
    rinzu.stdio.writeLine("SOURCE:input-ok:utf16:projection:geometry:detach");
    let child = session.view(rinzu.macos.Rect(x: 0.0, y: 0.0, width: 10.0, height: 10.0));
    let added = view.addSubview(child);
    var caught = false;
    try {
        let cycle = child.addSubview(view);
    }
    catch [problem: Error, ...rest] {
        rinzu.testing.assertEqual<Option<Int>>(
            err.nativeStatus(problem),
            Option<Int>.Some(value: -7804),
            "cycle status"
        );
        caught = true;
    }
    rinzu.testing.assertTrue(caught, "cycle rejected");
    let destroyed = view.destroy();
    caught = false;
    try {
        let stale = child.identity();
    }
    catch [problem: Error, ...rest] {
        rinzu.testing.assertEqual<Option<Int>>(
            err.nativeStatus(problem),
            Option<Int>.Some(value: -7802),
            "closed alias status"
        );
        caught = true;
    }
    rinzu.testing.assertTrue(caught, "closed alias rejected");
    shaped.exercise(session);
    rinzu.stdio.writeLine("SOURCE:core-ok");
}

async fn gpu(cancelled: Bool, recording: Bool, closing: Bool) {
    let session = rinzu.macos.open();
    let device = session.device();
    let library = device.library(
        r#"
#include <metal_stdlib>
using namespace metal;
kernel void increment(device uchar *data [[buffer(0)]], uint i [[thread_position_in_grid]]) { data[i] += 1; }
"#
    );
    let pipeline = library.computePipeline("increment");
    let buffer = device.buffer(bytesApi.from(b"\x00\xff\x40\x7f"));
    let command = device.command();
    var iteration = 0;
    while iteration < 3 {
        let begun = command.beginCompute(pipeline);
        let bound = command.setComputeBuffer(0, buffer, 0);
        let dispatched = command.dispatch(4, 1, 1, 4, 1, 1);
        if recording {
            rinzu.stdio.writeLine("SOURCE:recording-left-to-close");
            return;
        }
        let committed = command.commit();
        if closing {
            let closedEarly = await session.close();
            rinzu.stdio.writeLine("SOURCE:close-ok");
            return;
        }
        if cancelled {
            let pending = command.wait();
            let requested = future.cancel(pending);
            let result = await pending;
            rinzu.core.panic("queued waiter cancellation was lost");
        }
        let completed = await command.wait();
        iteration = iteration + 1;
    }
    let copied = buffer.read(0, 4);
    let destroyed = buffer.destroy();
    rinzu.testing.assertEqual<ByteArray>(
        copied,
        bytesApi.from(b"\x03\x02\x43\x82"),
        "owned GPU bytes after buffer destroy"
    );
    let abandoned = command.beginCompute(pipeline);
    let released = command.abandon();
    let stats = rinzu.macos.statistics();
    rinzu.testing.assertEqual<Int>(stats.commands, 1, "reuse one command control");
    rinzu.stdio.writeLine("SOURCE:gpu-ok");
    let closedFinal = await session.close();
}

async fn settleSessions() {
    let closed = await rinzu.macos.closeOwnerSessions();
    let stats = rinzu.macos.statistics();
    rinzu.testing.assertEqual<Int>(
        stats
            .sessions
            + stats
            .windows
            + stats
            .views
            + stats
            .devices
            + stats
            .buffers
            + stats
            .libraries
            + stats
            .pipelines
            + stats
            .commands
            + stats
            .bufferBytes,
        0,
        "all SDK payloads settled"
    );
    rinzu.stdio.writeLine("SOURCE:closed");
}

async fn run(mode: String) {
    try {
        if mode == "core" {
            await core();
        }
        else if mode == "callback" {
            await capturedRun();
        }
        else {
            await gpu(mode == "cancel", mode == "recording", mode == "close");
        }
    }
    finally {
        await settleSessions();
    }
}

async fn runCallback() {
    try {
        await capturedRun();
    }
    finally {
        await settleSessions();
    }
}

export run;
export runCallback;
