import "example.rinzu" as example;
import rinzu.macos;
import rinzu.stdio;
import rinzu.core;
import rinzu.timer;

async fn exercise(state: example.Viewer, job: rinzu.macos.UiJob) {
    switch state.canvas {
        case Option.Some(canvas): {
            await checkImage(state, canvas, job);
        }
        case Option.None: {
            rinzu.core.panic("viewer canvas was not created");
        }
    }
}

async fn checkImage(state: example.Viewer, canvas: rinzu.macos.Canvas2D, job: rinzu.macos.UiJob) {
    var ticks = 0;
    // A window resize requires the drawing job to release its drawable.
    while (state.loading || canvas.frames < 1 || canvas.drawing) && !job.isStopping() {
        if ticks > 1000 {
            rinzu.core.panic("viewer did not finish drawing its initial image");
        }
        await rinzu.timer.sleep(10);
        ticks = ticks + 1;
    }
    if job.isStopping() {
        rinzu.core.panic("viewer stopped before the resize");
    }
    let frames = canvas.frames;
    let resized = job.window.setContentSize(840.0, 600.0);
    state.filter = rinzu.macos.filterNearest;
    let zoomSize = canvas.view.drawableSize();
    let imageInfo = state.image.info();
    // The fitted image must fit inside both dimensions of the padded viewport.
    let widthScale = (zoomSize.width - 32.0) / Float(imageInfo.width);
    let heightScale = (zoomSize.height - 32.0) / Float(imageInfo.height);
    var fitted = widthScale;
    if heightScale < fitted {
        fitted = heightScale;
    }
    state.zoomBy(1.25);
    if state.fit || state.zoom <= fitted {
        rinzu.core.panic("zoom-in from Fit must increase the displayed scale");
    }
    while canvas.frames <= frames && !job.isStopping() {
        await rinzu.timer.sleep(10);
    }
    let size = canvas.view.frame();
    if size.width != 816.0 || size.height != 502.0 {
        rinzu.core.panic("viewer surface did not resize");
    }
    rinzu.stdio.writeLine("VIEWER:resize:zoom:nearest");
}

async fn screen(app: rinzu.macos.UiApplication) {
    let scope = app.primary;
    let frames = await example.withViewer(
        scope,
        async fn (state: example.Viewer, receive: fn (rinzu.macos.UiScope, rinzu.macos.UiEvent) -> Future<Unit>) {
            let job = scope.start(
                async fn (owner: rinzu.macos.UiJob) {
                    try {
                        await exercise(state, owner);
                    }
                    finally {
                        owner.requestStop();
                    }
                }
            );
            await scope.dispatch(receive);
        }
    );
}

async fn main() {
    await example.runApplication(screen);
}
